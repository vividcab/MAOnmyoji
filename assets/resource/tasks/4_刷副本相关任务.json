{
    "task": [
        {
            "name": "单刷各种副本",
            "label": "单刷各种副本",
            "description": "支持【活动爬塔】【御魂】【御灵】【业原火】【觉醒】【秘闻】【英杰经验】【英杰技能（自动选第一个技能）】【契灵结契】等页面右下角有【挑战】按钮的副本。\n执行本任务前，需要已经处于副本界面。\n请先手动刷一把，确认阵容配置正确，可以记录大致通关时间（通关时右上角记录的时间）。\n请在任务设置处输入自动挑战的次数和每局预计通关时间\n如果刷【契灵结契】（通过不断结契失败刷契忆换每周的六星御魂），默认是刷取第四个位置的契灵（狐火、小黑），如果需要刷其他契灵，请通过选项设置",
            "entry": "ENTRY-单刷副本任务入口",
            "group": ["standalone"],
            "option": [
                "输入挑战次数和通关时间",
                "是否使用随机等待",
                "契灵鸣契选择"
            ]
        },
        {
            "name": "单刷狭间暗域",
            "label": "单刷狭间暗域",
            "description": "僵尸寮狭间，单刷孔雀和白藏主暗域",
            "entry": "ENTRY-单刷狭间暗域任务",
            "group": ["standalone"]
        }
    ],
    "option": {
        "输入挑战次数和通关时间": {
            "type": "input",
            "label": "输入挑战次数和通关时间",
            "description": "输入纯数字",
            "inputs": [
                {
                    "name": "挑战次数",
                    "label": "挑战次数",
                    "description": "请输入整数。结合自身平时肝度设置，一般来说别搞通宵自动刷几小时问题都不大",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "default": "3"
                },
                {
                    "name": "预计每局通关时间",
                    "label": "预计每局通关时间",
                    "description": "请输入整数，单位是毫秒。挑战开始后第一次等待的时间，这个计时结束之后会每隔一段时间再检测是否通关。设置此参数只是减少几次检测，省一点点点性能，不在乎的话保持默认 5000（5秒）即可。",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "default": "5000"
                }
            ],
            "pipeline_override": {
                "检测挑战次数是否超过设置的次数": {
                    "recognition": {
                        "type": "Custom",
                        "param": {"custom_recognition": "Count", "custom_recognition_param": {"target": "{挑战次数}"}}
                    }
                },
                "检测已经开始战斗等待X秒": {"post_delay": "{预计每局通关时间}"}
            }
        },
        "是否使用随机等待": {
            "type": "switch",
            "default_case": "No",
            "label": "是否使用随机等待",
            "description": "模拟手动刷副本过程中，玩家可能中途离开去做别的事情：大部分时候等待间隔较短，有小概率情况间隔很久。不开启此选项也问题不大，由于任务过程有等待，每局通关时间本身也是不固定的。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ACT-检测还在战斗中再等3秒": {"action": "Custom", "custom_action": "RandomSleep"}
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ACT-检测还在战斗中再等3秒": {"action": "DoNothing"}
                    }
                }
            ]
        },
        "契灵鸣契选择": {
            "type": "select",
            "label": "契灵鸣契选择",
            "description": "【只有刷契灵时候这选项才有用】选择刷哪个位置的契灵，需要自己切换好地域，刷封魔之原还是平安京",
            "default_case": "位置四（狐火或小黑）",
            "cases": [
                {
                    "name": "位置四（狐火或小黑）",
                    "pipeline_override": {
                        "检测处于契灵之境点击要刷的契灵": {"target": [931, 470, 57, 56]}
                    }
                },
                {
                    "name": "位置一（针女或镇墓兽）",
                    "pipeline_override": {
                        "检测处于契灵之境点击要刷的契灵": {"target": [221, 483, 51, 46]}
                    }
                },
                {
                    "name": "位置二（薙魂或火灵）",
                    "pipeline_override": {
                        "检测处于契灵之境点击要刷的契灵": {"target": [425, 512, 49, 43]}
                    }
                },
                {
                    "name": "位置三（月魔兔或茨球）",
                    "pipeline_override": {
                        "检测处于契灵之境点击要刷的契灵": {"target": [681, 488, 46, 39]}
                    }
                }
            ]
        }
    }
}
